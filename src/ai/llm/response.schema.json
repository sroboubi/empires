{
  "anyOf": [
    {
      "type": "object",
      "description": "Execute a game action (Move, Attack, Repair, Build).",
      "required": [
        "type",
        "thoughtProcess",
        "entityId",
        "actionName",
        "target"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "COMMAND"
          ]
        },
        "thoughtProcess": {
          "type": "string",
          "description": "Brief strategic reasoning behind this turn's decision."
        },
        "entityId": {
          "type": "string",
          "description": "ID of your owned entity executing the order."
        },
        "actionName": {
          "type": "string",
          "description": "Action name from catalog (e.g. Move, Attack, Repair, Build)."
        },
        "target": {
          "description": "Target payload. Must specify exactly ONE target field.",
          "anyOf": [
            {
              "type": "object",
              "required": [
                "cell"
              ],
              "properties": {
                "cell": {
                  "type": "object",
                  "required": [
                    "q",
                    "r"
                  ],
                  "properties": {
                    "q": {
                      "type": "integer"
                    },
                    "r": {
                      "type": "integer"
                    }
                  }
                }
              }
            },
            {
              "type": "object",
              "required": [
                "entityId"
              ],
              "properties": {
                "entityId": {
                  "type": "string",
                  "description": "Target enemy or friendly entity ID (for Attack/Repair)."
                }
              }
            },
            {
              "type": "object",
              "required": [
                "entityName"
              ],
              "properties": {
                "entityName": {
                  "type": "string",
                  "description": "Target construct or unit type name (for Build)."
                }
              }
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "description": "Initiate diplomacy with an opponent.",
      "required": [
        "type",
        "thoughtProcess",
        "targetPlayerId"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "CHAT"
          ]
        },
        "thoughtProcess": {
          "type": "string",
          "description": "Brief strategic reasoning."
        },
        "targetPlayerId": {
          "type": "string",
          "description": "ID of opponent player to open chat with."
        }
      }
    },
    {
      "type": "object",
      "description": "End turn and save remaining orders.",
      "required": [
        "type",
        "thoughtProcess"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "END_TURN"
          ]
        },
        "thoughtProcess": {
          "type": "string",
          "description": "Brief strategic reasoning."
        },
        "note": {
          "type": "string",
          "description": "Strategic reminder to yourself for your next turn."
        }
      }
    }
  ]
}