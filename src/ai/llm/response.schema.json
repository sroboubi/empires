{
  "anyOf": [
    {
      "type": "object",
      "description": "Execute a game action (Move, Attack, Repair, Build).",
      "required": [
        "type",
        "thoughtProcess",
        "entityId",
        "command"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "COMMAND"
          ]
        },
        "thoughtProcess": {
          "type": "string",
          "description": "Brief strategic reasoning behind this turn's decision."
        },
        "entityId": {
          "type": "string",
          "description": "ID of your owned entity executing the order."
        },
        "command": {
          "type": "string",
          "enum": [
            "Attack",
            "Repair",
            "Build",
            "Explore"
          ],
          "description": "Command to perform"
        },
        "target": {
          "description": "Target is optional for Explore, required otherwise",
          "anyOf": [
            {
              "type": "object",
              "required": [
                "entityId"
              ],
              "properties": {
                "entityId": {
                  "type": "string",
                  "description": "Target enemy or friendly entity ID (for Attack/Repair)."
                }
              }
            },
            {
              "type": "object",
              "required": [
                "entityName"
              ],
              "properties": {
                "entityName": {
                  "type": "string",
                  "description": "Target construct or unit type name (for Build)."
                }
              }
            },
            {
              "type": "object",
              "required": [
                "direction"
              ],
              "properties": {
                "direction": {
                  "type": "string",
                  "enum": [
                    "E",
                    "NE",
                    "N",
                    "NW",
                    "W",
                    "SW",
                    "S",
                    "SE"
                  ],
                  "description": "Direction to explore in, if not provided then explore towards closest unexplored area"
                }
              }
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "description": "Initiate diplomacy with an opponent.",
      "required": [
        "type",
        "thoughtProcess",
        "targetPlayerId"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "CHAT"
          ]
        },
        "thoughtProcess": {
          "type": "string",
          "description": "Brief strategic reasoning."
        },
        "targetPlayerId": {
          "type": "string",
          "description": "ID of opponent player to open chat with."
        }
      }
    },
    {
      "type": "object",
      "description": "End turn and save remaining orders.",
      "required": [
        "type",
        "thoughtProcess"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "END_TURN"
          ]
        },
        "thoughtProcess": {
          "type": "string",
          "description": "Brief strategic reasoning."
        },
        "note": {
          "type": "string",
          "description": "Strategic reminder to yourself for your next turn."
        }
      }
    }
  ]
}