{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LLMTurnResponse",
  "type": "object",
  "required": [
    "type",
    "thoughtProcess"
  ],
  "properties": {
    "thoughtProcess": {
      "type": "string",
      "description": "Brief strategic reasoning."
    }
  },
  "oneOf": [
    {
      "properties": {
        "type": {
          "const": "COMMAND"
        },
        "entityId": {
          "type": "string",
          "description": "ID of owned entity executing the order."
        },
        "actionName": {
          "type": "string",
          "description": "Action name from entity catalog."
        },
        "target": {
          "type": "object",
          "oneOf": [
            {
              "required": [
                "cell"
              ],
              "properties": {
                "cell": {
                  "type": "object",
                  "required": [
                    "q",
                    "r"
                  ],
                  "properties": {
                    "q": {
                      "type": "integer"
                    },
                    "r": {
                      "type": "integer"
                    }
                  }
                }
              },
              "additionalProperties": false
            },
            {
              "required": [
                "entityId"
              ],
              "properties": {
                "entityId": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            {
              "required": [
                "entityName"
              ],
              "properties": {
                "entityName": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "type",
        "thoughtProcess",
        "entityId",
        "actionName",
        "target"
      ],
      "additionalProperties": false
    },
    {
      "properties": {
        "type": {
          "const": "CHAT"
        },
        "targetPlayerId": {
          "type": "string",
          "description": "ID of opponent player to open chat with."
        }
      },
      "required": [
        "type",
        "thoughtProcess",
        "targetPlayerId"
      ],
      "additionalProperties": false
    },
    {
      "properties": {
        "type": {
          "const": "END_TURN"
        },
        "note": {
          "type": "string",
          "description": "Note or reminder to yourself for your next turn."
        }
      },
      "required": [
        "type",
        "thoughtProcess"
      ],
      "additionalProperties": false
    }
  ]
}