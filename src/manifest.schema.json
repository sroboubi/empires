{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "GameManifest",
    "type": "object",
    "required": [
        "entities"
    ],
    "properties": {
        "players": {
            "type": "array",
            "description": "List of player configurations participating in the game.",
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "name",
                    "color"
                ],
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string"
                    },
                    "color": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "controller": {
                        "type": [
                            "object",
                            "string",
                            "null"
                        ]
                    }
                }
            }
        },
        "resources": {
            "type": "array",
            "description": "Global resources tracked by the game engine.",
            "items": {
                "type": "object",
                "required": [
                    "name",
                    "iconUrl"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "Unique name (e.g., 'gold', 'wood')"
                    },
                    "iconUrl": {
                        "type": "string",
                        "format": "uri",
                        "description": "2D image asset for UIs"
                    }
                }
            }
        },
        "naturalResources": {
            "type": "array",
            "description": "Global resources tracked by the game engine.",
            "items": {
                "type": "object",
                "required": [
                    "name",
                    "iconUrl"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "Unique name (e.g., 'gold', 'wood')"
                    },
                    "iconUrl": {
                        "type": "string",
                        "format": "uri",
                        "description": "2D image asset for UIs"
                    }
                }
            }
        },
        "terrains": {
            "type": "array",
            "description": "Terrain definitions used by the terrain provider and hex grid.",
            "items": {
                "type": "object",
                "required": [
                    "name",
                    "height",
                    "movementCost",
                    "material",
                    "conditions"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "Unique display name of the terrain type."
                    },
                    "height": {
                        "type": "number",
                        "description": "Height / elevation scale for rendering."
                    },
                    "movementCost": {
                        "type": "number",
                        "description": "Action points / movement cost to traverse this terrain."
                    },
                    "material": {
                        "type": "object",
                        "description": "Three.js material properties.",
                        "properties": {
                            "color": {
                                "type": [
                                    "string",
                                    "integer"
                                ],
                                "description": "Color hex string or hex integer value."
                            },
                            "roughness": {
                                "type": "number"
                            },
                            "metalness": {
                                "type": "number"
                            },
                            "transparent": {
                                "type": "boolean"
                            },
                            "opacity": {
                                "type": "number"
                            },
                            "flatShading": {
                                "type": "boolean"
                            }
                        }
                    },
                    "conditions": {
                        "type": "object",
                        "description": "Procedural noise conditions (min/max) for elevation, temperature, and humidity.",
                        "properties": {
                            "elevation": {
                                "type": "object",
                                "properties": {
                                    "min": {
                                        "type": "number"
                                    },
                                    "max": {
                                        "type": "number"
                                    }
                                }
                            },
                            "temperature": {
                                "type": "object",
                                "properties": {
                                    "min": {
                                        "type": "number"
                                    },
                                    "max": {
                                        "type": "number"
                                    }
                                }
                            },
                            "humidity": {
                                "type": "object",
                                "properties": {
                                    "min": {
                                        "type": "number"
                                    },
                                    "max": {
                                        "type": "number"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "entities": {
            "type": "array",
            "description": "Game pieces (Terrain, Units, Constructs) that can occupy the hex grid.",
            "items": {
                "type": "object",
                "required": [
                    "name",
                    "modelUrl",
                    "controllerUrl"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "Unique name (e.g., 'swordsman', 'mine')"
                    },
                    "modelUrl": {
                        "type": "string",
                        "format": "uri",
                        "description": "Path to the 3D .glb file"
                    },
                    "controllerUrl": {
                        "type": "string",
                        "format": "uri",
                        "description": "Path to the JS module defining the controller class"
                    },
                    "rotationOffset": {
                        "type": "number",
                        "description": "Y-axis rotation offset in degrees to orient GLB model correctly"
                    },
                    "sightRange": {
                        "type": "integer",
                        "minimum": 0,
                        "description": "Vision sight range in hex cell radius"
                    },
                    "spawnConditions": {
                        "type": "object",
                        "description": "Conditions required to spawn or build the entity on a hex cell.",
                        "properties": {
                            "terrain": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "description": "List of allowed terrain type names the entity can be spawned on."
                            },
                            "minSeparation": {
                                "type": "integer",
                                "minimum": 0,
                                "description": "Minimum cell distance from any other construct entity."
                            }
                        }
                    },
                    "damage": {
                        "type": "object",
                        "properties": {
                            "value": {
                                "type": "number"
                            },
                            "type": {
                                "type": "string"
                            },
                            "elevationAdjustment": {
                                "type": "number",
                                "description": "Multiplier/divisor applied based on relative elevation between attacker and target."
                            }
                        }
                    },
                    "sfx": {
                        "type": "object",
                        "description": "Sound effect file names for entity events, relative to sfx.basePath. 'action' may be a file name or an object keyed by action name.",
                        "properties": {
                            "select": {
                                "type": "string",
                                "description": "Played when the entity is selected"
                            },
                            "action": {
                                "anyOf": [
                                    {
                                        "type": "string"
                                    },
                                    {
                                        "type": "object",
                                        "description": "Maps lowercased action names (e.g. move, attack) to file names; 'default' is the fallback."
                                    }
                                ],
                                "description": "Played when the entity performs an action"
                            },
                            "build": {
                                "type": "string",
                                "description": "Played when this construct finishes building"
                            },
                            "damage": {
                                "type": "string",
                                "description": "Played when the entity takes damage"
                            },
                            "destroy": {
                                "type": "string",
                                "description": "Played when the entity is destroyed"
                            }
                        },
                        "additionalProperties": false
                    }
                }
            }
        },
        "initialization": {
            "type": "object",
            "description": "Starting setup parameters applied to each player when a new game begins.",
            "required": [
                "startingResources",
                "startingUnits"
            ],
            "properties": {
                "orders": {
                    "type": "object",
                    "description": "Per-player command orders available for unit actions each turn.",
                    "required": [
                        "max",
                        "initial",
                        "perTurn"
                    ],
                    "properties": {
                        "max": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "Maximum orders a player can hold."
                        },
                        "initial": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "Orders each player starts with."
                        },
                        "perTurn": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "Orders added at the start of each of the player's turns, capped at max."
                        }
                    }
                },
                "startingResources": {
                    "type": "object",
                    "description": "Map of resource names to starting quantities for every player.",
                    "additionalProperties": {
                        "type": "integer",
                        "minimum": 0
                    }
                },
                "startingUnits": {
                    "type": "object",
                    "description": "Map of unit entity names to spawn counts for each player.",
                    "additionalProperties": {
                        "type": "integer",
                        "minimum": 1
                    }
                }
            }
        },
        "sfx": {
            "type": "object",
            "description": "Global audio configuration: base path and UI sounds.",
            "properties": {
                "basePath": {
                    "type": "string",
                    "description": "Base path for all SFX file names"
                },
                "ui": {
                    "type": "object",
                    "description": "UI event sounds (click, turn, ...)",
                    "properties": {
                        "click": {
                            "type": "string"
                        },
                        "turn": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    }
}
