{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "GameManifest",
    "type": "object",
    "required": [
        "resources",
        "entities"
    ],
    "properties": {
        "players": {
            "type": "array",
            "description": "List of player configurations participating in the game.",
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "name",
                    "color"
                ],
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string"
                    },
                    "color": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "controller": {
                        "type": [
                            "object",
                            "string",
                            "null"
                        ]
                    }
                }
            }
        },
        "resources": {
            "type": "array",
            "description": "Global resources tracked by the game engine.",
            "items": {
                "type": "object",
                "required": [
                    "name",
                    "iconUrl"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "Unique name (e.g., 'gold', 'wood')"
                    },
                    "iconUrl": {
                        "type": "string",
                        "format": "uri",
                        "description": "2D image asset for UIs"
                    }
                }
            }
        },
        "entities": {
            "type": "array",
            "description": "Game pieces (Terrain, Units, Constructs) that can occupy the hex grid.",
            "items": {
                "type": "object",
                "required": [
                    "name",
                    "modelUrl",
                    "controllerUrl"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "Unique name (e.g., 'swordsman', 'mine')"
                    },
                    "modelUrl": {
                        "type": "string",
                        "format": "uri",
                        "description": "Path to the 3D .glb file"
                    },
                    "controllerUrl": {
                        "type": "string",
                        "format": "uri",
                        "description": "Path to the JS module defining the controller class"
                    },
                    "rotationOffset": {
                        "type": "number",
                        "description": "Y-axis rotation offset in degrees to orient GLB model correctly"
                    },
                    "sightRange": {
                        "type": "integer",
                        "minimum": 0,
                        "description": "Vision sight range in hex cell radius"
                    }
                }
            }
        },
        "initialization": {
            "type": "object",
            "description": "Starting setup parameters applied to each player when a new game begins.",
            "required": [
                "startingResources",
                "startingUnits"
            ],
            "properties": {
                "orders": {
                    "type": "object",
                    "description": "Per-player command orders available for unit actions each turn.",
                    "required": [
                        "max",
                        "initial",
                        "perTurn"
                    ],
                    "properties": {
                        "max": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "Maximum orders a player can hold."
                        },
                        "initial": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "Orders each player starts with."
                        },
                        "perTurn": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "Orders added at the start of each of the player's turns, capped at max."
                        }
                    }
                },
                "startingResources": {
                    "type": "object",
                    "description": "Map of resource names to starting quantities for every player.",
                    "additionalProperties": {
                        "type": "integer",
                        "minimum": 0
                    }
                },
                "startingUnits": {
                    "type": "object",
                    "description": "Map of unit entity names to spawn counts for each player.",
                    "additionalProperties": {
                        "type": "integer",
                        "minimum": 1
                    }
                }
            }
        }
    }
}