{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TreasuresDefinition",
  "type": "array",
  "description": "Treasures (ruins) placed on map cells at generation. A unit moving onto the cell collects it: a random reward is picked `quantity` times. One resource OR treasure per cell (no stacking).",
  "items": {
    "type": "object",
    "required": [
      "name",
      "terrains",
      "rewards"
    ],
    "properties": {
      "name": {
        "type": "string",
        "description": "Unique treasure name (e.g. 'smallRuins')."
      },
      "terrains": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "types",
            "modelUrls",
            "quantity",
            "probability"
          ],
          "properties": {
            "types": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Terrain names this group can spawn on (e.g. 'Grasslands', 'Hills')."
            },
            "modelUrls": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "GLB models to pick from when spawning. One random model per item."
            },
            "quantity": {
              "type": "object",
              "required": [
                "min",
                "max"
              ],
              "properties": {
                "min": {
                  "type": "integer",
                  "minimum": 1
                },
                "max": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "description": "How many items spawn on a single cell (visual count)."
            },
            "probability": {
              "type": "object",
              "required": [
                "base",
                "adjacent"
              ],
              "properties": {
                "base": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "Spawn chance on an eligible cell with no adjacent same-type items."
                },
                "adjacent": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "Spawn chance on an eligible empty cell adjacent to the same resource/treasure type (clustering)."
                }
              }
            },
            "size": {
              "type": "number",
              "minimum": 0.1,
              "description": "Optional: normalize models so their largest dimension equals HEX_SIZE * size. Defaults to 1."
            }
          }
        }
      },
      "rewards": {
        "type": "array",
        "description": "Reward table. One random entry is granted per treasure quantity point.",
        "items": {
          "type": "object",
          "required": [
            "type",
            "quantity"
          ],
          "properties": {
            "type": {
              "type": "string",
              "description": "Resource key granted to the collecting player's stockpile."
            },
            "quantity": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}